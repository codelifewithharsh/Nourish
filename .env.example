# Copy this file to .env.local for development.
# For EAS builds, set these in EAS Secrets or in eas.json env per profile.
#
# Variables prefixed with EXPO_PUBLIC_ are baked into the client bundle.
# Do NOT put server-only secrets here.

# Supabase project (different for dev vs prod)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only secrets (used by Edge Functions, set in Supabase Dashboard)
# OPENAI_API_KEY=  ← set this in Supabase Dashboard → Edge Functions → Secrets
