{
  "expo": {
    "name": "Nourish",
    "slug": "nourish",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "nourish",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nourish.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1A3A2A",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "notification": {
        "icon": "./assets/android-icon-monochrome.png",
        "color": "#1A3A2A"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nourish.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A3A2A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "./plugins/withoutPushEntitlement"
    ],
    "extra": {
      "eas": {
        "projectId": "4786fcd8-9c8e-4f2e-b8fc-90fa06d721fe"
      },
      "router": {}
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "codelifewithharsh",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4786fcd8-9c8e-4f2e-b8fc-90fa06d721fe"
    }
  }
}
